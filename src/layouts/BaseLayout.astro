---
import HamburgerMenu from "@components/HamburgerMenu";
import RevealAnimations from "@components/RevealAnimations.astro";
import ThemeProvider from "@components/ThemeProvider.astro";
import { ClientRouter } from "astro:transitions";
import aboutData from "@/data/about";
import { getAlternateLocale, getTranslations } from "@/i18n";
import { getAlternatePath, getNavItems } from "@/i18n/utils";
import type { Locale, NavItem } from "@/types";
import "@styles/global.css";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  currentPath?: string;
  navItems?: NavItem[];
  showHamburgerMenu?: boolean;
  showWindowViewOption?: boolean;
  menuEnterDelayMs?: number;
  mainClass?: string;
  /** For error pages: keeps the page out of search results and leaves out its
   * canonical and language-alternate links, which would point at nothing. */
  noindex?: boolean;
}

const {
  title,
  description,
  locale,
  currentPath = "",
  navItems: navItemsProp,
  showHamburgerMenu = true,
  showWindowViewOption = false,
  menuEnterDelayMs,
  mainClass = "page-content",
  noindex = false,
} = Astro.props;
const t = getTranslations(locale);
const altLocale = getAlternateLocale(locale);
const navItems = navItemsProp ?? getNavItems(locale);
const pageDescription = description ?? aboutData[locale].description;
const documentTitle =
  title === "Isabella Nunes" ? title : `${title} - Isabella Nunes`;
const canonicalUrl = new URL(currentPath, Astro.site).toString();
const alternatePath = getAlternatePath(currentPath, locale);
const alternateUrl = new URL(alternatePath, Astro.site).toString();
const defaultUrl = new URL(
  currentPath.replace(/^\/en(\/|$)/, "/pt$1"),
  Astro.site,
).toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{documentTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={locale === "pt" ? "pt_BR" : "en_US"} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonicalUrl} />
          <meta property="og:url" content={canonicalUrl} />
          <link rel="alternate" hreflang={altLocale} href={alternateUrl} />
          <link rel="alternate" hreflang="x-default" href={defaultUrl} />
        </>
      )
    }
    <ThemeProvider />
    <ClientRouter />
  </head>
  <body>
    <RevealAnimations />

    {
      showHamburgerMenu && (
        <HamburgerMenu
          client:load
          locale={locale}
          currentPath={currentPath}
          navItems={navItems}
          translations={{ common: t.common }}
          showWindowView={showWindowViewOption}
          enterDelayMs={menuEnterDelayMs}
        />
      )
    }
    <main class={mainClass}>
      <slot />
    </main>
  </body>
</html>
