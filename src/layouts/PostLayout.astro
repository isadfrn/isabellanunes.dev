---
import Breadcrumb from "@components/Breadcrumb";
import HamburgerMenu from "@components/HamburgerMenu";
import ThemeProvider from "@components/ThemeProvider.astro";
import { ClientRouter } from "astro:transitions";
import aboutData from "@/data/about";
import { getAlternateLocale, getTranslations } from "@/i18n";
import { getAlternatePath, getNavItems } from "@/i18n/utils";
import type { Locale, NavItem } from "@/types";
import "@styles/global.css";

interface BreadcrumbItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  currentPath?: string;
  breadcrumbItems: BreadcrumbItem[];
  navItems?: NavItem[];
}

const {
  title,
  description,
  locale,
  currentPath = "",
  breadcrumbItems,
  navItems: navItemsProp,
} = Astro.props;
const t = getTranslations(locale);
const altLocale = getAlternateLocale(locale);
const navItems = navItemsProp ?? getNavItems(locale);
const pageDescription = description ?? aboutData[locale].description;
const canonicalUrl = new URL(currentPath, Astro.site).toString();
const alternatePath = getAlternatePath(currentPath, locale);
const alternateUrl = new URL(alternatePath, Astro.site).toString();
const defaultUrl = new URL(currentPath.replace(/^\/en(\/|$)/, "/pt$1"), Astro.site).toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} - Isabella Nunes</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${title} - Isabella Nunes`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === "pt" ? "pt_BR" : "en_US"} />
    <link rel="alternate" hreflang={altLocale} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    <ThemeProvider />
    <ClientRouter />
  </head>
  <body>
    <HamburgerMenu
      client:load
      locale={locale}
      currentPath={currentPath}
      navItems={navItems}
      translations={{ common: t.common }}
    />
    <main class="page-content lg:ml-64">
      <nav aria-label="Breadcrumb" class="container pb-2 pt-6">
        <Breadcrumb items={breadcrumbItems} />
      </nav>
      <slot />
    </main>
  </body>
</html>
