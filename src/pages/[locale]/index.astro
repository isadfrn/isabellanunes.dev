---
import MobileFeed from "@components/mobile/MobileFeed.astro";
import SceneStage from "@components/scene/SceneStage.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { SCENE_REVEAL } from "@/config/scene";
import { getPortfolio } from "@/data/portfolio";
import { getNavItems } from "@/i18n/utils";
import { locales, type Locale } from "@/types";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const portfolio = await getPortfolio(locale);
---

<BaseLayout
  title="Isabella Nunes"
  description={portfolio.about.description}
  locale={locale}
  currentPath={Astro.url.pathname}
  navItems={getNavItems(locale)}
  showWindowViewOption
  menuEnterDelayMs={SCENE_REVEAL.hotspotsDelayMs}
  mainClass="page-content sm:h-screen sm:overflow-hidden"
>
  {
    /* Two experiences for one page, switched at the `sm` breakpoint: the
     interactive scene from there up, the classic scrolling feed below it.
     A static page can't tell the viewport in advance, so both are in the HTML
     and CSS hides the one that doesn't apply. */
  }
  <div class="hidden sm:contents">
    <SceneStage locale={locale} portfolio={portfolio} />
  </div>

  <div class="sm:hidden">
    <MobileFeed locale={locale} portfolio={portfolio} />
  </div>
</BaseLayout>
