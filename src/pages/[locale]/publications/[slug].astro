---
import PublicationLanguageBadge from "@components/PublicationLanguageBadge.astro";
import PostLayout from "@layouts/PostLayout.astro";
import publicationsData from "@/data/publications";
import { getTranslations } from "@/i18n";
import { getNavItems } from "@/i18n/utils";
import { locales, type Locale } from "@/types";

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    publicationsData[locale].map((publication) => ({
      params: { locale, slug: publication.slug },
      props: { publication },
    })),
  );
}

const locale = Astro.params.locale as Locale;
const { publication } = Astro.props;
const t = getTranslations(locale);
const navItems = getNavItems(locale);
const currentPath = Astro.url.pathname;
const breadcrumbItems = [
  { href: `/${locale}/`, label: t.breadcrumb.home },
  { href: `/${locale}/publications`, label: t.breadcrumb.publications },
  { href: currentPath, label: publication.title },
];
---

<PostLayout
  title={publication.title}
  description={publication.abstract}
  locale={locale}
  currentPath={currentPath}
  navItems={navItems}
  breadcrumbItems={breadcrumbItems}
>
  <article class="container page-enter pb-20 pt-8 pl-16 md:pl-8 lg:pl-0">
    <div class="max-w-3xl">
      <div class="mb-4 flex items-start justify-between gap-4">
        <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-50 md:text-4xl">
          {publication.title}
        </h1>
        <PublicationLanguageBadge
          language={publication.language}
          labelPt={t.publications.lang_badge_pt}
          labelEn={t.publications.lang_badge_en}
          ariaPt={t.publications.lang_badge_aria_pt}
          ariaEn={t.publications.lang_badge_aria_en}
        />
      </div>
      <dl class="mb-8 grid gap-4 rounded-lg border border-slate-200 bg-white p-5 text-sm dark:border-slate-700 dark:bg-slate-800 sm:grid-cols-3">
        <div>
          <dt class="font-medium text-slate-900 dark:text-slate-100">{t.publications.authors}</dt>
          <dd class="mt-1 text-slate-500 dark:text-slate-400">{publication.authors.join(", ")}</dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900 dark:text-slate-100">{t.publications.venue}</dt>
          <dd class="mt-1 text-slate-500 dark:text-slate-400">{publication.venue}</dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900 dark:text-slate-100">{t.publications.year}</dt>
          <dd class="mt-1 text-slate-500 dark:text-slate-400">{publication.year}</dd>
        </div>
      </dl>
      {publication.abstract && (
        <p class="text-justify text-base leading-relaxed text-slate-600 dark:text-slate-300">
          {publication.abstract}
        </p>
      )}
      {publication.url && (
        <a
          href={publication.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex rounded-lg bg-primary-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-600"
        >
          {t.publications.view_publication}
        </a>
      )}
    </div>
  </article>
</PostLayout>
