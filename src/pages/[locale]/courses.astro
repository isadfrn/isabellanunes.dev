---
import CourseCard from "@components/CourseCard";
import BaseLayout from "@layouts/BaseLayout.astro";
import coursesData from "@/data/courses";
import { getTranslations } from "@/i18n";
import { getNavItems } from "@/i18n/utils";
import { locales, type Locale } from "@/types";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getTranslations(locale);
const navItems = getNavItems(locale);
const currentPath = Astro.url.pathname;
const courses = coursesData[locale];
---

<BaseLayout
  title={t.courses.title}
  locale={locale}
  currentPath={currentPath}
  navItems={navItems}
>
  <article class="container page-enter min-h-screen flex-1 py-20 pl-16 md:pl-8 lg:pl-0">
    <div class="max-w-4xl">
      <h1 class="mb-10 text-3xl font-bold text-slate-900 dark:text-slate-50 md:text-4xl">
        {t.courses.title}
      </h1>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {courses.map((course, index) => (
          <CourseCard
            entry={course}
            labels={{ certificate: t.courses.certificate, viewCourse: t.courses.viewCourse }}
            revealDelay={index * 80}
          />
        ))}
      </div>
    </div>
  </article>
</BaseLayout>
