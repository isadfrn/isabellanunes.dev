---
import Timeline from "@components/Timeline";
import type { Locale, TimelineEntry } from "@/types";

interface Props {
  entries: TimelineEntry[];
  locale: Locale;
  presentLabel: string;
}

const { entries, locale, presentLabel } = Astro.props;
---

<Timeline
  entries={entries}
  locale={locale}
  granularity="year"
  presentLabel={presentLabel}
  orgAsBadge
/>
