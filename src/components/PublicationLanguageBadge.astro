---
import type { Locale } from "@/types";

interface LocaleLabel {
  label: string;
  aria: string;
}

interface Props {
  language: Locale;
  labels: Record<Locale, LocaleLabel>;
}

const { language, labels } = Astro.props;
const { label, aria } = labels[language];
---

<span
  class="inline-flex shrink-0 items-center rounded-full border border-primary-100/80 bg-primary-50 px-2 py-0.5 text-xs font-medium text-primary-700 dark:border-primary-800/50 dark:bg-primary-900/40 dark:text-primary-300"
  aria-label={aria}
>
  {label}
</span>
