---
import BookCard from "@components/BookCard";
import { getImage } from "astro:assets";
import ComputerDesktop from "@components/scene/ComputerDesktop.astro";
import DesktopWindow from "@components/scene/DesktopWindow.astro";
import { getPrinterModels } from "@/config/printerModels";
import { findVisual } from "@/config/scene";
import { isWindowEnabled } from "@/config/scene.actions";
import { toImageWidth } from "@/config/scene.geometry";
import { IMAGE_FORMAT, IMAGE_QUALITY, nativeWidth } from "@/config/sceneImages";
import type { Portfolio } from "@/data/portfolio";
import { getTranslations } from "@/i18n";
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
  portfolio: Portfolio;
}

const { locale, portfolio } = Astro.props;
const t = getTranslations(locale);

// Each model is shipped at the size it is printed at on the bed (which is
// plenty for its thumbnail in the picker too).
const printWidth = findVisual("rig")?.objectBox.width;
const printerModels = await Promise.all(
  getPrinterModels().map(async ({ id, name, image }) => ({
    id,
    name,
    image: await getImage({
      src: image,
      width: printWidth
        ? toImageWidth(printWidth, nativeWidth(image))
        : nativeWidth(image),
      format: IMAGE_FORMAT,
      quality: IMAGE_QUALITY,
    }),
  })),
);
---

{
  isWindowEnabled("books") && (
    <DesktopWindow
      id="books"
      title={t.books.title}
      closeLabel={t.common.closeWindow}
    >
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {portfolio.books.map((book, index) => (
          <BookCard
            entry={book}
            labels={{ buyBook: t.books.buyBook }}
            revealDelay={index * 80}
          />
        ))}
      </div>
    </DesktopWindow>
  )
}

<DesktopWindow
  id="printer"
  title={t.printer.title}
  closeLabel={t.common.closeWindow}
>
  {
    printerModels.length > 0 ? (
      <form data-action="run-printer" class="flex flex-col gap-4">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {printerModels.map((model, index) => (
            <label
              class="cursor-pointer"
              data-reveal
              style={`--reveal-delay:${index * 80}ms`}
            >
              <input
                type="radio"
                name="printer-model"
                value={model.image.src}
                class="peer sr-only"
              />
              <span class="flex flex-col items-center gap-2 rounded-lg border border-slate-100 bg-white p-3 text-center shadow-sm transition-colors peer-checked:border-primary-500 peer-checked:ring-2 peer-checked:ring-primary-500 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-primary-500 dark:border-slate-700 dark:bg-slate-800">
                <img
                  src={model.image.src}
                  width={model.image.attributes.width}
                  height={model.image.attributes.height}
                  loading="lazy"
                  decoding="async"
                  alt=""
                  class="h-20 w-full object-contain"
                />
                <span class="text-xs font-medium text-slate-600 dark:text-slate-300">
                  {model.name}
                </span>
              </span>
            </label>
          ))}
        </div>
        <button
          type="submit"
          class="self-end rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-primary-700"
        >
          {t.printer.printButton}
        </button>
      </form>
    ) : (
      <p class="text-sm text-slate-500 dark:text-slate-400">
        {t.printer.emptyState}
      </p>
    )
  }
</DesktopWindow>

<DesktopWindow
  id="computer-os"
  title={t.computerDesktop.osWindowTitle}
  closeLabel={t.common.closeWindow}
  flushBody
  size="large"
>
  <ComputerDesktop locale={locale} portfolio={portfolio} />
</DesktopWindow>
